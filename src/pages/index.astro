---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import About from "../components/sections/About.astro";
import Reviews from "../components/sections/Reviews.astro";
import Offers from "../components/sections/Offers.astro";
import Process from "../components/sections/Process.astro";
import FAQ from "../components/sections/FAQ.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout
  title="Airco & warmtepomp installateur in Gelderland"
  description="Specialist in airco's, warmtepompen en elektrotechniek. Vaste prijs, 3 jaar garantie, installatie binnen 4 weken. Gevestigd in Overasselt."
>
  <Header />
  <main>
    <Hero />
    <Services />
    <About />
    <Reviews />
    <Offers />
    <Process />
    <FAQ />
