---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = "/og-default.jpg",
  noindex = false,
} = Astro.props;

const siteName = "Heijmans Techniek";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="nl_NL" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#BA0B0D" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HVACBusiness",
      "name": "Heijmans Techniek",
      "image": new URL("/og-default.jpg", Astro.site).href,
      "telephone": "+31630614042",
      "email": "info@heijmanstechniek.nl",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Molenkuil 4",
        "postalCode": "6611 AS",
        "addressLocality": "Overasselt",
        "addressCountry": "NL"
      },
      "areaServed": "Gelderland",
      "priceRange": "€€",
      "url": Astro.site?.href,
    })} />
  </head>
  <body class="bg-surface-warm">

    <!-- Decorative shapes - fixed achter content -->
    <div aria-hidden="true" style="position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden;">

      <!-- Cyaan cirkel top-right -->
      <div style="position: absolute; top: -200px; right: -200px; width: 500px; height: 500px; border-radius: 9999px; background-color: #0d9bc5; opacity: 0.025;"></div>

      <!-- Rode ring midden-links -->
      <div style="position: absolute; top: 45%; left: -150px; width: 350px; height: 350px; border-radius: 9999px; border: 50px solid #ba0b0d; opacity: 0.022;"></div>

      <!-- Cyaan ring bottom-right -->
      <div style="position: absolute; bottom: -100px; right: -120px; width: 380px; height: 380px; border-radius: 9999px; border: 45px solid #0d9bc5; opacity: 0.025;"></div>
    </div>

    <!-- Content boven shapes -->
    <div style="position: relative; z-index: 10;">
      <slot />
    </div>
  </body>
  <script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -80px 0px' }
  );

  document.querySelectorAll('.animate-on-scroll').forEach((el) => {
    observer.observe(el);
  });
</script>
</html>