---
import Container from "../ui/Container.astro";

const reviews = [
  {
    name: "Dennis Brood",
    date: "1 maand geleden",
    service: "Algemeen",
    quote: "Gewoon goeie vakmensen. Mannen die hard werken en eerlijk advies geven. Geen verkooppraatje, maar een nette installatie en duidelijke uitleg achteraf.",
  },
  {
    name: "Bart L.",
    date: "2 maanden geleden",
    service: "Airco",
    quote: "Aardige en zeer kundige installateur. Vakman.",
  },
  {
    name: "Mark van de L.",
    date: "2 maanden geleden",
    service: "Airco",
    quote: "Fijne, eerste ervaring. Deskundig en vriendelijk geholpen. Dank.",
  },
  {
    name: "André Kaelen",
    date: "4 maanden geleden",
    service: "Warmtepomp",
    quote: "Voor onze pas gekochte woning waren wij op zoek naar een betrouwbare installateur. Heijmans Techniek heeft ons uitstekend geholpen, van advies tot installatie.",
  },
  {
    name: "Maryn Maarsen",
    date: "5 maanden geleden",
    service: "Airco",
    quote: "Jeremy heeft bij ons op zeer korte termijn een airco geplaatst. De installatie ging soepel en netjes. Top service.",
  },
];
---

<section id="reviews" class="relative bg-transparent animate-on-scroll">

  <Container class="relative pt-2 md:pt-4 pb-12 md:pb-16 lg:pb-20">

    <!-- Section header -->
    <div class="mb-6 md:mb-8 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6 sm:flex-wrap">
      <h2 class="text-[1.5rem] sm:text-3xl lg:text-[2rem] tracking-[-0.025em] text-text-primary leading-tight">
        Reviews
      </h2>
      <span class="text-xs sm:text-sm text-text-secondary">
        Wat klanten zeggen
      </span>
    </div>

    <!-- Trust strip -->
    <a href="https://www.google.com/search?q=heijmans+techniek+overasselt" target="_blank" rel="noopener noreferrer" class="group flex flex-col sm:flex-row sm:items-center justify-between gap-4 sm:gap-6 p-5 sm:p-6 md:p-7 mb-2.5 sm:mb-4 md:mb-5 bg-white rounded-2xl sm:rounded-3xl border border-border-subtle hover:border-border-default transition-colors">

      <div class="flex items-center gap-4 sm:gap-5">
        <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-surface-warm flex items-center justify-center shrink-0">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
        </div>

        <div class="flex flex-col gap-0.5">
          <div class="flex items-baseline gap-2">
            <span class="text-2xl sm:text-3xl font-semibold text-text-primary tracking-[-0.02em] leading-none">5.0</span>
            <div class="flex items-center gap-0.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
          </div>
          <span class="text-xs sm:text-sm text-text-secondary">
            Op basis van 60+ Google reviews
          </span>
        </div>
      </div>

      <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-text-primary group-hover:text-brand-red transition-colors shrink-0">
        Bekijk alle reviews
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </span>
    </a>

    <!-- Reviews grid -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-2.5 sm:gap-4 md:gap-5">

      {reviews.map((r) => (
        <article class="bg-white rounded-2xl sm:rounded-3xl border border-border-subtle hover:border-border-default p-3 sm:p-5 md:p-6 transition-colors flex flex-col">

          <div class="flex items-center justify-between gap-2 mb-2 sm:mb-3">
            <div class="flex items-center gap-0.5">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <span class="text-[9px] sm:text-[10px] font-medium tracking-wider uppercase text-text-muted">
              {r.service}
            </span>
          </div>

          <p class="text-xs sm:text-sm md:text-[15px] text-text-primary leading-[1.55] sm:leading-[1.65] flex-1">
            {r.quote}
          </p>

          <div class="mt-3 sm:mt-4 pt-2 sm:pt-3 border-t border-border-subtle flex items-center justify-between gap-2">
            <div class="flex flex-col min-w-0">
              <span class="text-xs sm:text-sm font-medium text-text-primary truncate">{r.name}</span>
              <span class="text-[10px] sm:text-xs text-text-muted">{r.date}</span>
            </div>
            <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true" class="shrink-0 opacity-60 sm:w-3.5 sm:h-3.5">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>
        </article>
      ))}

      <!-- CTA card als 6e tile -->
      <a href="#offerte" class="group relative bg-brand-red text-white rounded-2xl sm:rounded-3xl border border-brand-red hover:bg-brand-red-hover transition-all duration-300 overflow-hidden flex flex-col p-3 sm:p-5 md:p-6">

        <div class="flex items-center justify-between gap-2 mb-2 sm:mb-3">
          <div class="flex items-center gap-0.5">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="#FBBC05" aria-hidden="true" class="sm:w-3.5 sm:h-3.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <span class="text-[9px] sm:text-[10px] font-medium tracking-wider uppercase text-white/70">
            Jouw beurt
          </span>
        </div>

        <p class="text-sm sm:text-base md:text-lg text-white tracking-[-0.015em] leading-[1.3] font-medium flex-1">
          Word de volgende tevreden klant.
        </p>

        <div class="mt-3 sm:mt-4 pt-2 sm:pt-3 border-t border-white/20 flex items-center justify-between gap-2">
          <span class="text-xs sm:text-sm font-semibold text-white">Plan kennismaking</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-white shrink-0 group-hover:translate-x-0.5 transition-transform">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </div>
      </a>
    </div>

  </Container>
</section>