---
import Container from "../ui/Container.astro";
---

<section class="relative bg-transparent">
  <Container class="relative py-10 md:py-16 lg:py-20">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-14 items-center">

      <!-- LEFT copy -->
      <div>
        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-4 md:mb-5">
          <span class="h-px w-6 md:w-8 bg-brand-cyan"></span>
          <span class="text-[11px] md:text-xs font-medium tracking-wider uppercase text-text-secondary">
            Heijmans Techniek · Overasselt
          </span>
        </div>

        <!-- H1 -->
        <h1 class="text-[1.75rem] sm:text-4xl lg:text-[2.75rem] xl:text-5xl leading-[1.15] sm:leading-[1.1] tracking-[-0.025em] sm:tracking-[-0.03em] text-text-primary">
          <span class="block">Specialist in <span class="text-brand-cyan">airco's</span>,</span>
          <span class="block"><span class="text-brand-red">warmtepompen</span> en elektra.</span>
        </h1>

        <!-- Sub -->
        <p class="mt-5 md:mt-6 text-[15px] md:text-base text-text-secondary max-w-xl lg:max-w-none leading-[1.65] md:leading-relaxed">
          Met persoonlijk advies aan huis en een vaste prijs vooraf weet je precies waar je aan toe bent. Binnen 3 weken geïnstalleerd, met 3 jaar montagegarantie.
        </p>

        <!-- CTAs -->
        <div class="mt-7 md:mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 md:gap-x-6">
          <a href="#offerte" class="inline-flex items-center justify-center gap-2 bg-brand-red hover:bg-brand-red-hover text-white px-5 md:px-6 py-3 md:py-3.5 rounded-full font-medium text-sm transition-all active:scale-[0.98] group">
            Gratis offerte aanvragen
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>

          <a href="https://www.google.com/search?q=heijmans+techniek+overasselt" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white hover:bg-surface-warm border border-border-default text-text-primary pl-1.5 pr-4 py-2 md:py-1.5 rounded-full font-medium text-sm transition-all active:scale-[0.98]">
            <span class="flex items-center justify-center w-8 h-8 bg-surface-warm rounded-full shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
            </span>
            <span class="flex flex-col items-start leading-tight">
              <span class="text-[10px] text-text-muted font-normal">Google reviews</span>
              <span class="flex items-center gap-1">
                <span class="text-brand-red text-[10px]">★★★★★</span>
                <span class="font-semibold text-xs">5.0</span>
              </span>
            </span>
          </a>
        </div>

        <!-- Trust row -->
        <div class="mt-8 md:mt-10 grid grid-cols-1 sm:flex sm:flex-wrap sm:items-center gap-y-2 text-sm text-text-secondary">
          <span class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
            6 jaar ervaring
          </span>
          <span class="hidden sm:block sm:mx-4 w-px h-3 bg-brand-cyan/30"></span>
          <span class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
            STEK-gecertificeerd
          </span>
          <span class="hidden sm:block sm:mx-4 w-px h-3 bg-brand-cyan/30"></span>
          <span class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan shrink-0"><polyline points="20 6 9 17 4 12"/></svg>
            Vaste prijs tot 10 meter
          </span>
        </div>
      </div>

      <!-- RIGHT foto -->
      <div class="relative order-first lg:order-last">
        <div class="relative aspect-[4/3] sm:aspect-[5/4] lg:aspect-[4/4.2] rounded-2xl md:rounded-[1.75rem] overflow-hidden bg-surface-dark">
          <img src="/hero-jeremy.jpg" alt="Jeremy Heijmans, oprichter Heijmans Techniek" class="absolute inset-0 w-full h-full object-cover" width="600" height="630" loading="eager" fetchpriority="high" />
        </div>
        <div class="absolute -bottom-1 left-6 right-6 md:left-8 md:right-8 h-1 bg-brand-red rounded-full" aria-hidden="true"></div>
      </div>
    </div>
  </Container>
</section>