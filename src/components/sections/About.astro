---
import Container from "../ui/Container.astro";
---

<section id="over" class="relative bg-transparent animate-on-scroll">

  <Container class="relative pt-2 md:pt-4 pb-12 md:pb-16 lg:pb-20">

    <!-- Section header -->
    <div class="mb-6 md:mb-8 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6 sm:flex-wrap">
      <h2 class="text-[1.5rem] sm:text-3xl lg:text-[2rem] tracking-[-0.025em] text-text-primary leading-tight">
        Over Heijmans Techniek
      </h2>
      <span class="text-xs sm:text-sm text-text-secondary">
        Eén vakman, één aanspreekpunt
      </span>
    </div>

    <!-- Profile card -->
    <article class="bg-white rounded-2xl sm:rounded-3xl border border-border-subtle overflow-hidden">
      <div class="grid lg:grid-cols-[0.85fr_1fr]">

        <!-- Photo + identifier overlay -->
        <div class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-auto lg:min-h-[640px] bg-surface-warm overflow-hidden">
          <img src="/over-jeremy.jpg" alt="Jeremy Heijmans, oprichter Heijmans Techniek" class="absolute inset-0 w-full h-full object-cover object-top" loading="lazy" onerror="this.style.opacity=0" />

          <!-- Name overlay bottom-left -->
          <div class="absolute bottom-0 left-0 right-0 p-4 sm:p-6 md:p-7 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
            <div class="flex items-center gap-2.5 mb-1 sm:mb-1.5">
              <span class="h-px w-5 bg-brand-cyan"></span>
              <span class="text-[10px] sm:text-[11px] font-medium tracking-wider uppercase text-white/80">
                Oprichter · Overasselt
              </span>
            </div>
            <h3 class="text-lg sm:text-2xl md:text-[1.75rem] text-white tracking-[-0.025em] leading-[1.05] font-medium">
              Jeremy Heijmans
            </h3>
          </div>
        </div>

        <!-- Content column -->
        <div class="flex flex-col">

          <!-- BLOK 1: Story -->
          <div class="px-5 sm:px-7 md:px-9 py-5 sm:py-7 md:py-8">
            <p class="text-[15px] sm:text-base md:text-lg text-text-primary tracking-[-0.015em] leading-[1.4] font-medium">
              Eerlijk advies, eigen handen, drie jaar garantie.
            </p>
            <p class="mt-3 sm:mt-4 text-sm sm:text-[15px] text-text-secondary leading-[1.75]">
              Al zes jaar werk ik als zelfstandig installateur in Gelderland. Begonnen met airco's, gegroeid naar warmtepompen, cv-ketels en elektrotechniek. Wat ik elke dag merk: mensen willen vooral weten waar ze aan toe zijn. Geen verkooppraatje, geen onverwachte rekeningen, gewoon iemand die zegt wat hij doet en doet wat hij zegt.
            </p>
          </div>

          <!-- BLOK 2: USP bullets -->
          <div class="px-5 sm:px-7 md:px-9 py-5 sm:py-6 md:py-7 border-t border-border-subtle">
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-2.5">
              <li class="flex items-start gap-2 text-sm sm:text-[15px] text-text-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><span class="text-text-primary font-medium">3 jaar</span> garantie op montage</span>
              </li>
              <li class="flex items-start gap-2 text-sm sm:text-[15px] text-text-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Service en onderhoud</span>
              </li>
              <li class="flex items-start gap-2 text-sm sm:text-[15px] text-text-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span><span class="text-text-primary font-medium">Vrijblijvend</span> advies aan huis</span>
              </li>
              <li class="flex items-start gap-2 text-sm sm:text-[15px] text-text-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan shrink-0 mt-0.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Installatie binnen <span class="text-text-primary font-medium">4 weken</span></span>
              </li>
            </ul>
          </div>

          <!-- BLOK 3: CTA -->
          <div class="px-5 sm:px-7 md:px-9 py-4 sm:py-5 md:py-6 border-t border-border-subtle bg-surface-warm/40 mt-auto">
            <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 sm:gap-x-5">
              <a href="#offerte" class="inline-flex items-center justify-center gap-2 bg-brand-red hover:bg-brand-red-hover text-white px-5 py-3 rounded-full font-medium text-sm transition-all active:scale-[0.98] group w-full sm:w-auto">
                Plan kennismaking
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href="tel:+31630614042" class="inline-flex items-center justify-center gap-2 text-sm font-medium text-text-primary hover:text-brand-red transition-colors w-full sm:w-auto py-2 sm:py-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-brand-cyan"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                06 30 61 40 42
              </a>
            </div>
          </div>

        </div>
      </div>
    </article>

  </Container>
</section>