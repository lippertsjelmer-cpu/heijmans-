---
interface Props {
  variant?: "neutral" | "accent";
  class?: string;
}

const { variant = "neutral", class: className = "" } = Astro.props;

const variants = {
  neutral:
    "bg-white border border-[var(--color-border-subtle)] text-[var(--color-text-secondary)]",
  accent:
    "bg-[var(--color-brand-red)]/10 text-[var(--color-brand-red)]",
};
---

<span
  class={`inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-medium ${variants[variant]} ${className}`}
>
  <slot />
</span>