              <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-text-primary/10 text-text-primary flex items-center justify-center group-hover/item:bg-text-primary group-hover/item:text-white transition-all duration-300">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="7" y1="9" x2="9" y2="9"/><line x1="11" y1="9" x2="13" y2="9"/><line x1="15" y1="9" x2="17" y2="9"/><line x1="7" y1="15" x2="17" y2="15"/></svg>
              </div>
              <span class="text-sm font-medium text-text-primary flex-1">Meterkast</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-text-muted group-hover/item:text-text-primary group-hover/item:translate-x-0.5 transition-all"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>

            <a href="#dienst-laadpaal" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-surface-warm transition-colors group/item">
              <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-text-primary/10 text-text-primary flex items-center justify-center group-hover/item:bg-text-primary group-hover/item:text-white transition-all duration-300">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </div>
              <span class="text-sm font-medium text-text-primary flex-1">Laadpaal</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-text-muted group-hover/item:text-text-primary group-hover/item:translate-x-0.5 transition-all"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
