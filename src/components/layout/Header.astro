---
import Container from "../ui/Container.astro";
---

<header id="site-header" class="sticky top-0 z-50 bg-white border-b border-border-subtle transition-shadow duration-300">
  <Container class="flex items-center justify-between gap-6 h-16 lg:h-20">

    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0 transition-transform duration-300 hover:scale-[1.02] group" aria-label="Heijmans Techniek home">
      <img src="/logo.png" alt="Heijmans Techniek" class="h-8 lg:h-10 w-auto" width="220" height="40" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center" aria-label="Hoofdnavigatie">

      <!-- DIENSTEN -->
      <div class="relative group">
        <button class="flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-text-primary whitespace-nowrap">
          <span class="relative">
            Diensten
            <span class="absolute -bottom-1 left-0 right-0 h-0.5 bg-brand-red rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>
          </span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="transition-transform duration-300 group-hover:rotate-180 text-text-secondary">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>

        <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 w-[300px]">
          <div class="bg-white rounded-3xl border border-border-subtle shadow-xl shadow-black/5 p-2">

            <a href="#dienst-airco" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-surface-warm transition-colors group/item">
              <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-brand-cyan/10 text-brand-cyan flex items-center justify-center group-hover/item:bg-brand-cyan group-hover/item:text-white transition-all duration-300">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v20"/><path d="m4.93 4.93 14.14 14.14"/><path d="M2 12h20"/><path d="m4.93 19.07 14.14-14.14"/></svg>
              </div>
              <span class="text-sm font-medium text-text-primary flex-1">Airco</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-text-muted group-hover/item:text-brand-cyan group-hover/item:translate-x-0.5 transition-all"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>

            <a href="#dienst-cv" class="flex items-center gap-3 px-4 py-3 rounded-2xl hover:bg-surface-warm transition-colors group/item">
              <div class="flex-shrink-0 w-9 h-9 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center group-hover/item:bg-brand-red group-hover/item:text-white transition-all duration-300">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><line x1="10" y1="6" x2="14" y2="6"/><line x1="10" y1="10" x2="14" y2="10"/></svg>
              </div>
              <span class="text-sm font-medium text-text-primary flex-1">CV-ketel</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="text-text-muted group-hover/item:text-brand-red group-hover/item:translate-x-0.5 transition-all"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
